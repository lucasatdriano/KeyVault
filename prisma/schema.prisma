// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  REGISTER
  VERIFY_EMAIL

  LOGIN
  LOGOUT

  CREATE_CREDENTIAL
  UPDATE_CREDENTIAL
  DELETE_CREDENTIAL
  RESTORE_CREDENTIAL
  COPY_PASSWORD

  CHANGE_MASTER_PASSWORD

  EXPORT_DATA
  IMPORT_DATA

  ENABLE_RECOVERY_METHOD
  DISABLE_RECOVERY_METHOD

  GENERATE_RECOVERY_KEY
  RESET_PASSWORD

  UPDATE_PROFILE
  CHANGE_EMAIL
}

enum RecoveryType {
  EMAIL
  QUESTIONS
  RECOVERY_KEY
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String   @db.Text

  encryptedVaultKey   String   @db.Text
  isRecoverable       Boolean  @default(false)

  emailVerified       Boolean  @default(false)
  emailVerifiedAt     DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  emailVerifications  EmailVerification[]
  credentials         Credential[]
  categories          Category[]
  auditLogs           AuditLog[]
  recoveryMethods     RecoveryMethod[]
  recoveryQuestions   RecoveryQuestion[]
  recoverySessions    RecoverySession[]
}

model EmailVerification {
    id         String   @id @default(cuid())

    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    tokenHash  String   @db.Char(64)
    expiresAt  DateTime
    usedAt     DateTime?

    createdAt  DateTime @default(now())

    @@index([userId])
    @@index([tokenHash])
    @@index([expiresAt])
}

model Credential {
  id                   String    @id @default(cuid())
         
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
         
  cipherText           String    @db.Text
         
  iv                   String    @db.Text
  salt                 String    @db.Text
         
  version              Int       @default(1)
  algorithm            String    @default("AES-256-GCM")
  resourceSearchHash   String?   @db.Char(64)

  favorite             Boolean   @default(false)
         
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
         
  auditLogs            AuditLog[]

  @@index([userId])
  @@index([categoryId])
  @@index([favorite])
  @@index([deletedAt])
}

model Category {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cipherText  String   @db.Text
  iv          String   @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials Credential[]

  @@index([userId])
}

model AuditLog {
  id                 String        @id @default(cuid())

  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId       String?
  credential         Credential?   @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  action             AuditAction

  resourceSearchHash String? @db.Char(64)

  browser            String?
  os                 String?
  device             String?
  ip                 String?

  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([credentialId])
  @@index([action])
  @@index([resourceSearchHash])
  @@index([createdAt])
}

model RecoveryMethod {
  id         String       @id @default(cuid())

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       RecoveryType
  enabled    Boolean      @default(false)

  secretHash String?      @db.Text

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model RecoverySession {
  id             String   @id @default(cuid())
  
  userId         String
  user           User     @relation( fields: [userId], references: [id], onDelete: Cascade)

  currentStep    Int      @default(0)
  completedSteps Int      @default(0)

  tokenHash      String   @db.Text

  expiresAt      DateTime
  completedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenges     RecoveryChallenge[]

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RecoveryChallenge {
  id          String          @id @default(cuid())
  
  sessionId   String
  session     RecoverySession @relation( fields: [sessionId], references: [id], onDelete: Cascade)

  type        RecoveryType

  tokenHash   String          @db.Text

  expiresAt   DateTime
  completedAt DateTime?

  createdAt   DateTime        @default(now())

  @@index([sessionId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RecoveryQuestion {
  id                String   @id @default(cuid())
  
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionCipherText String  @db.Text
  questionIv         String  @db.Text

  answerHash        String   @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}